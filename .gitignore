# Local virtualenv
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]

# Build artefacts
build/
dist/
*.egg-info/


# Editor settings
.vscode/

# Weimar Jazz Database (42 MB, downloaded from jazzomat.hfm-weimar.de; see
# CORPUS_PLAN.md). Not part of the source tree.
*.db

# Renderer and export output from the corpus CLI. Regenerate rather than commit:
# the HTML renders are per-tune debugging aids and the exports are snapshots of
# whatever the renderer produced at the time, so a stale one in the tree is worse
# than none. .gp5 in particular is checked by opening it in a notation program.
*.html
*.musicxml
*.gp5
leadsheet_export.json

